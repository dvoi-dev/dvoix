{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dvoix",
  "version": "0.2.0",
  "identifier": "me.damavoi.dvoix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dvoix",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1RjA1NzFFODQ5RUQ3NDAKUldSQTE1NkVIbGZ3SlhZa2tvc3dFQW56NzIxaTQvblFrTEtpVXA0cytTNFRmSld0KysvanZ1bmYK",
      "endpoints": [
        "https://github.com/dvoi-dev/dvoix/releases/latest/download/latest.json"
      ]
    }
  }
}
